# Copy to scripts/release.env and fill values.
# scripts/release.env is intentionally untracked.

# Required for notarization
DEV_ID_APP="Developer ID Application: YOUR NAME (TEAMID)"
AC_PROFILE="your-notarytool-keychain-profile"

# Optional app naming
APP_DISPLAY_NAME="Back Channel"
APP_EXECUTABLE_NAME="Backchannel"

# Optional output zip name from notarize_release.sh
# Defaults to <APP_DISPLAY_NAME-with-dashes>.zip
ZIP_NAME="Back-Channel.zip"

# Optional dedicated managed support release channel
MANAGED_SUPPORT_TAG="managed-support"
MANAGED_SUPPORT_TITLE="Managed Support"

# Required managed support runtime inputs.
# DENO_BINARY must be a standalone Mach-O binary.
DENO_BINARY="/absolute/path/to/standalone/deno"

# Optional: portable Python runtime used to build the managed Python source runtime
# that carries both yt-dlp and Streamlink.
# Defaults to a tested python-build-standalone archive if omitted.
# PYTHON_STANDALONE_URL="https://github.com/astral-sh/python-build-standalone/releases/download/20260320/cpython-3.13.12+20260320-aarch64-apple-darwin-install_only_stripped.tar.gz"
# PYTHON_STANDALONE_ARCHIVE="/absolute/path/to/cpython-3.13.12+20260320-aarch64-apple-darwin-install_only_stripped.tar.gz"

# Optional: pip package spec for the managed Python source runtime's yt-dlp package.
# Defaults to latest yt-dlp from PyPI.
# YTDLP_PACKAGE_SPEC="yt-dlp==2026.03.17"

# Required bundled native tools for the app bundle.
# Use portable binaries you are comfortable distributing.
# FFMPEG_BINARY="/absolute/path/to/ffmpeg"
# FFPROBE_BINARY="/absolute/path/to/ffprobe"

# Optional bundle/version metadata passed through to build
# APP_BUNDLE_ID="com.example.backchannel"
# APP_SHORT_VERSION="1.2.3"
# APP_BUILD_VERSION="123"
